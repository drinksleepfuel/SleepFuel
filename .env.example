# SleepFuel Shopify Storefront — environment variables
# Copy to .env.local for local dev. In production, configure these in
# Oxygen → Storefront → Environment variables (Shopify admin).

# --- Shopify storefront ---
PUBLIC_STORE_DOMAIN=your-shop.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-10

# --- Shopify admin (server-side ONLY) ---
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2025-10

# --- Hydrogen session ---
# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Klaviyo (email-capture popup) ---
# Required to actually subscribe emails and return a discount code.
# Without these, the popup still renders and "succeeds" but doesn't send
# the email to Klaviyo.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
KLAVIYO_DISCOUNT_CODE=WELCOME15
